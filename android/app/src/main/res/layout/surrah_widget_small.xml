<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical">

    <!-- Header: App Title + Quick Add Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="صُـرّة"
            android:textColor="#00CCCD"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_add_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_input_add"
            android:background="@drawable/widget_add_btn_bg"
            android:contentDescription="Add Expense"
            android:padding="5dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_budget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:progressDrawable="@drawable/widget_progress_bar"
        android:max="100"
        android:progress="0" />

    <!-- Remaining Budget Section -->
    <TextView
        android:id="@+id/widget_remaining_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الميزانية المتبقية"
        android:textColor="#B0B0B0"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_remaining_budget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- د.ع"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Today Spent Section -->
    <TextView
        android:id="@+id/widget_today_spent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="مصاريف اليوم"
        android:textColor="#B0B0B0"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_today_spent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- د.ع"
        android:textColor="#FF4D80"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
